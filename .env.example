# Arbitrage Opportunity Alerts (Vercel serverless + Supabase)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Public site origin used in unsubscribe links and email CTAs
ALERTS_SITE_ORIGIN=https://coinnavigator.net

# Required to invoke GET/POST /api/alerts/match (GitHub Actions + curl)
# CRON_SECRET=long-random-string

# Opportunity + optional confirmation email (disabled unless RESEND_API_KEY is set)
# RESEND_API_KEY=re_xxx
# ALERTS_FROM_EMAIL=CoinNavigator Alerts <alerts@coinnavigator.net>

# Live Route Validator (POST /api/route-validator)
# No env vars required — uses public exchange market data only.
# See ROUTE_VALIDATOR_SETUP.md

# Market Data Gateway (GET /api/market-data)
# No env vars required — public tickers only. See MARKET_DATA_SETUP.md

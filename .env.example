# Arbitrage Opportunity Alerts (Vercel serverless + Supabase)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Optional: public site origin used in unsubscribe links
ALERTS_SITE_ORIGIN=https://coinnavigator.net

# Optional confirmation email (disabled unless set)
# RESEND_API_KEY=re_xxx
# ALERTS_FROM_EMAIL=CoinNavigator <alerts@coinnavigator.net>

# Live Route Validator (POST /api/route-validator)
# No env vars required — uses public exchange market data only.
# See ROUTE_VALIDATOR_SETUP.md

# Market Data Gateway (GET /api/market-data)
# No env vars required — public tickers only. See MARKET_DATA_SETUP.md
